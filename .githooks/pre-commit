#!/bin/sh
# ハーネスのコミット関門。① ハーネス repo(ikmstack)でも、setup で配線した
# ② 記録層(ノート)でも同じこのフックが走る（.githooks/ は symlink）。
#
# 記録層向けの検査は cwd 基準で experiments/ を見る。ハーネス自身の検査
# (policy gate / harness map) は、そのソースが cwd にあるときだけ走る。
#
# **成功時も1行サマリを出す。** 「検査して OK」と「検査対象が0件」は意味が全く違うのに、
# 黙って通ると区別がつかない。対象数はこのフックが自分で数える(ツールの出力を
# 解析しない = 文言変更で壊れない)。凡例: ✓=検査した / —=対象なし / skip=ソースなし
#
# 有効化(クローンごと): git config core.hooksPath .githooks
# 一時的に無視したい場合のみ: git commit --no-verify

# python3 を優先解決（現代 macOS は `python` を提供しない）。無ければ検査をスキップ。
PY=$(command -v python3 || command -v python || true)
if [ -z "$PY" ]; then
  echo "⚠ pre-commit: python3/python が見つからないため各検査をスキップします。" >&2
  exit 0
fi

# --- 対象数を数える(凡例の ✓ / — を決めるため) --------------------------------
# `_` 始まり(_template 等)は実験ではないので除く。
count_dirs() {   # $1 = glob パターン
  n=0
  for d in $1; do
    [ -d "$d" ] || continue
    case "$(basename "$d")" in _*) continue ;; esac
    n=$((n + 1))
  done
  echo "$n"
}
count_files() {  # $1 = glob パターン
  n=0
  for f in $1; do [ -e "$f" ] && n=$((n + 1)); done
  echo "$n"
}

N_EXP=$(count_dirs 'experiments/*/')
N_DRGATE=$(count_files 'experiments/*/.dr-gate')
N_NUMGATE=$(count_files 'experiments/*/.numbers-gate')

mark() {  # $1 = 対象数 → ✓ か —
  [ "$1" -gt 0 ] && printf '✓' || printf '—'
}
SUMMARY=""
add() { SUMMARY="${SUMMARY}${SUMMARY:+ / }$1"; }

# report フロントマター ↔ INDEX.md のドリフトをコミット前に検出する。
out=$("$PY" tools/report_meta.py --check 2>&1)
status=$?
if [ "$status" -ne 0 ]; then
  echo "$out"
  echo
  echo "✗ report のフロントマターと INDEX.md が一致していません(または不備があります)。"
  echo "  → python3 tools/report_meta.py で INDEX を再生成し、変更を git add してから再コミットしてください。"
  exit 1
fi
add "index $(mark "$N_EXP")"

# 不備を隔離してスキップした場合(report_meta.py「不備の隔離」)は、commit を止めずに
# 通知だけする。1 実験の不備で全員の commit を止めないための意図的な非ブロッキング。
if echo "$out" | grep -q '^WARN:'; then
  echo "$out"
  echo
  echo "⚠ 上記はフロントマター不備のため INDEX から除外されています(commit は継続)。"
fi

# 図リンクが再生成出力先(_generated/ 等の gitignored)を指すか検査(三大原則#1 R3)。
out=$("$PY" tools/check_report_figures.py --check 2>&1)
status=$?
if [ "$status" -ne 0 ]; then
  echo "$out"
  echo
  echo "✗ レポートの図リンクが再生成出力先を指していません(AGENTS.md 三大原則#1 R3)。"
  echo "  → 図リンクを ../_generated/<plots>/… 等(.gitignore 済の出力先)に直してください。"
  exit 1
fi
add "figures $(mark "$N_EXP")"

# 実験ごと opt-in の dr-audit 軽量ゲート(.dr-gate マーカのある実験だけ)。
# safe-by-construction: staged な実験が .dr-gate マーカを持つときだけ走る。
out=$("$PY" tools/dr/dr_gate_precommit.py 2>&1)
status=$?
if [ "$status" -ne 0 ]; then
  echo "$out"
  echo
  echo "✗ dr-audit 軽量ゲートが失敗しました(.dr-gate マーカのある実験)。"
  echo "  → 台帳を直すか、python3 tools/dr/dr_gate_precommit.py --all --verbose で確認してください。"
  exit 1
fi
add "dr $(mark "$N_DRGATE")"

# 実験ごと opt-in の「追跡できない数値」リンタ(.numbers-gate のある実験だけ)。
# 値の正しさは見ない(それは上の dr ゲートの役目)。
out=$("$PY" tools/check_untraceable_numbers.py 2>&1)
status=$?
if [ "$status" -ne 0 ]; then
  echo "$out"
  echo
  echo "✗ 出典アンカーの無い数値があります(.numbers-gate のある実験)。"
  echo "  → リンク / <id>-R### / 図・スクリプトのパス / 出典 / data-era を近くに置くか、"
  echo "    定義上その必要が無い数値には <!-- numbers-ok: 理由 --> を付けてください。"
  exit 1
fi
add "numbers $(mark "$N_NUMGATE")"

# --- ここから下はハーネス自身(① ikmstack)の検査 ------------------------------
# 記録層(② ノート)には規約の正本が無いので、ソースが cwd にあるときだけ走らせる。
if [ -f docs/conventions/policy-registry.json ]; then
  # 規約の正本と写しのドリフト検査(1ルール=1正本+ピン留め)。
  out=$("$PY" tools/policy_gate.py 2>&1)
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "$out"
    echo
    echo "✗ ハーネス規約の正本と写しがずれています(policy gate)。"
    echo "  → python3 tools/policy_gate.py --all --verbose で確認。正本/レジストリを直したら"
    echo "    写しのピンを更新(digest は --digest <id>)、マップは --write-map で再生成。"
    exit 1
  fi
  add "policy ✓"
else
  add "policy skip"
fi

if [ -f docs/harness-map.md ]; then
  # ハーネス地図の棚卸し(生成部)がソースとずれていないかの鮮度検査。
  out=$("$PY" tools/harness_map.py --check 2>&1)
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "$out"
    echo
    echo "✗ ハーネス地図の棚卸し(生成部)がソースとずれています。"
    echo "  → python3 tools/harness_map.py で再生成し、git add docs/harness-map.md してください。"
    exit 1
  fi
  add "map ✓"
else
  add "map skip"
fi

if [ -d .claude/skills ] && [ -f tools/notebook_map.py ]; then
  # ② 記録層の地図に手書きされた skill 一覧の鮮度検査。skill の増減は必ずここ(①)で
  # 起きるので、**ドリフトを作った側のコミットで**気づかせる。ノートは別 repo であり
  # ここで直せない(=止めても直せない)ので、警告のみでコミットは通す。
  out=$("$PY" tools/notebook_map.py 2>&1)
  if printf '%s' "$out" | grep -q '⚠'; then
    echo "$out"
    echo "⚠ 記録層の地図の skill 一覧がハーネスの実体とずれています(コミットは通します)。"
    add "nbmap ⚠"
  else
    add "nbmap ✓"
  fi
else
  add "nbmap skip"
fi

# --- 成功サマリ(✓=検査した / —=対象なし / skip=ソースなし)--------------------
echo "pre-commit: $SUMMARY"
exit 0
