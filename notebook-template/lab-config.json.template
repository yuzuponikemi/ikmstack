{
  "notebook_name": "{{NOTEBOOK}}",
  "harness": "ikmstack",
  "mode": "hybrid",
  "experiment_id_pattern": "^E\\d+_[a-z0-9-]+$",
  "experiment_id_prefix": "E",
  "_google_drive_root_note": "macOS の Drive for desktop のマウント先。個人アカウントは 'My Drive'(日本語環境でも英語名)。Workspace の共有ドライブを使うなら 'Shared drives/<drive>' に差し替える。空にすると Drive 連携をスキップする",
  "google_drive_root": "~/Library/CloudStorage/GoogleDrive-<account>/My Drive/{{NOTEBOOK}}/experiments/",
  "allowed_figure_roots": [
    "_generated",
    "figures"
  ],
  "jira_enabled": false,
  "retraction_rule_epoch": "0000-00-00",
  "harness_repo_path": "../ikmstack",
  "sidecar": {
    "enabled": true,
    "_note": "記録のルーティングは tools/sidecar.py が担う（ikmstack/docs/conventions/record-routing.md）。実験は常にノート根、日次ログは起動元 repo なら sidecar/<slug>/logs/ へ。"
  }
}
