{
  "$comment": "Policy registry. Machine truth for '1 rule = 1 canonical location'. Hand-edited. Human view: policy-map.md (generated by tools/policy_gate.py --write-map). Gate: tools/policy_gate.py (pre-commit; actual gate order is generated in docs/harness-map.md). surface は「手で保守するハーネスのソース」だけ。生成物(docs/harness-map.md 等)と 記録(logs/experiments/tips)は false-positive farm なので入れない。Registry existence itself is the opt-in marker: delete this file and the gate becomes a no-op.",
  "$format": {
    "surface": "glob patterns (repo-root relative) that the gate scans. Keep strictly limited to harness source; logs/experiments/tips are append-only records and MUST stay out (false-positive farm).",
    "rule": {
      "id": "kebab-case slug; pins reference it as policy:<id>@<digest8>",
      "title": "one-line human name",
      "canonical": "file (+ optional anchor = heading name) where the rule's full text lives",
      "key_lines": "operational strings only (commands, paths, fixed phrases). Matching strips ALL whitespace on both sides, so line wraps don't matter. Never key on paraphrasable prose.",
      "copies": "files that restate the rule; each MUST carry the pin <!-- policy:<id>@<digest8> -->",
      "allow": "files allowed to contain key_lines without a pin (exempt from C3)",
      "enforced_by": "informational: deterministic tool that enforces the rule at runtime, if any"
    }
  },
  "version": 1,
  "surface": [
    "AGENTS.md",
    "README.md",
    "CLAUDE.md",
    ".claude/skills/*/SKILL.md",
    ".claude/skills/*/references/*.md",
    "docs/conventions/*.md"
  ],
  "rules": [
    {
      "id": "report-meta-regen",
      "title": "INDEX は手書きせず report_meta.py で再生成する",
      "canonical": {
        "file": "AGENTS.md",
        "anchor": "実験のワークフロー"
      },
      "key_lines": [
        "python3 tools/report_meta.py",
        "python3 tools/report_meta.py --check"
      ],
      "copies": [
        {
          "file": "docs/conventions/reporting.md"
        },
        {
          "file": ".claude/skills/exp-new/SKILL.md"
        },
        {
          "file": ".claude/skills/exp-report/SKILL.md"
        },
        {
          "file": ".claude/skills/exp-checkpoint/SKILL.md"
        },
        {
          "file": ".claude/skills/exp-checkpoint/references/checkpoint_procedure.md"
        },
        {
          "file": ".claude/skills/exp-report/references/exp_report_guide.md"
        },
        {
          "file": ".claude/skills/dr-synth/SKILL.md"
        }
      ],
      "enforced_by": "tools/report_meta.py --check (pre-commit)"
    },
    {
      "id": "figures-not-in-git",
      "title": "図は git に入れない(三大原則#1、R1〜R3)",
      "canonical": {
        "file": "docs/conventions/figures-regen.md"
      },
      "key_lines": [
        "tools/check_report_figures.py"
      ],
      "copies": [
        {
          "file": "AGENTS.md"
        },
        {
          "file": ".claude/skills/exp-new/SKILL.md"
        },
        {
          "file": ".claude/skills/regen-outputs/references/regen_guide.md"
        }
      ],
      "enforced_by": "tools/check_report_figures.py (pre-commit)"
    },
    {
      "id": "report-naming-numbering",
      "title": "レポート命名 <実験ID>-R### と R 番号の規律(リビング文書に R を振らない)",
      "canonical": {
        "file": "docs/conventions/reporting.md",
        "anchor": "レポート命名・R 番号"
      },
      "key_lines": [
        "E###-R###"
      ],
      "copies": [
        {
          "file": ".claude/skills/exp-report/SKILL.md"
        },
        {
          "file": "AGENTS.md"
        },
        {
          "file": "docs/conventions/repository-rules.md"
        },
        {
          "file": ".claude/skills/report-checksum/SKILL.md"
        },
        {
          "file": ".claude/skills/exp-checkpoint/references/checkpoint_procedure.md"
        },
        {
          "file": ".claude/skills/exp-report/references/exp_report_guide.md"
        },
        {
          "file": ".claude/skills/dr-synth/SKILL.md"
        }
      ]
    },
    {
