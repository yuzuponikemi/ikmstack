#!/usr/bin/env bash
# ikmstack setup — install the ① harness (skills + agents) globally so any
# repo can consume it, and wire a ② records notebook (ikmnote) to the harness.
#
# Usage:
#   ./setup                      global install: skills → ~/.claude/skills,
#                                agents → ~/.claude/agents (idempotent)
#   ./setup --prefix ikm-        namespace skills as ikm-<name>
#   ./setup --init-notebook <dir>  scaffold a NEW records notebook (② layer)
#                                from scratch: structure + template + docs +
#                                git init + wiring. One command, reproducible.
#   ./setup --notebook <dir>     wire an EXISTING records repo: symlink tools/ +
#                                .githooks/ from this install (gitignored) so the
#                                harness skills' relative `tools/…` calls + the
#                                figure/INDEX pre-commit hook work in the notebook
#   ./setup --sync-notebook <dir>  refresh what the harness OWNS in an existing
#                                notebook: relink experiments/_template, refresh the
#                                managed block in .gitignore, and report doc drift.
#                                Safe to re-run; never touches records.
#   ./setup --forget-notebook <dir>  unregister a notebook (records untouched);
#                                the default falls back to the last one wired
#   ./setup --sync               multi-machine: fetch + ff-only pull the harness
#                                and every registered notebook, then report what
#                                is still unpushed. One command instead of N.
#   ./setup --status             report install health: skills/agents symlinks,
#                                install-path, registered notebooks, git state,
#                                verdict
#   ./setup --uninstall          remove the global symlinks this script created
#
# The harness is never vendored into the notebook's git history — the notebook
# tracks records only; tools/ + .githooks/ are gitignored symlinks to here.
set -e

SRC="$(cd "$(dirname "$0")" && pwd -P)"
SKILLS_DST="$HOME/.claude/skills"
AGENTS_DST="$HOME/.claude/agents"
STATE_DIR="$HOME/.ikmstack"

PREFIX=""
MODE="install"
NOTEBOOK=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix) PREFIX="${2:-ikm-}"; shift 2 ;;
    --prefix=*) PREFIX="${1#--prefix=}"; shift ;;
    --notebook) MODE="notebook"; NOTEBOOK="$2"; shift 2 ;;
    --sync-notebook) MODE="sync-notebook"; NOTEBOOK="$2"; shift 2 ;;
    --init-notebook) MODE="init-notebook"; NOTEBOOK="$2"; shift 2 ;;
    --forget-notebook) MODE="forget-notebook"; NOTEBOOK="$2"; shift 2 ;;
    --status) MODE="status"; shift ;;
    --sync) MODE="sync"; shift ;;
    --uninstall) MODE="uninstall"; shift ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
done

# ── link helper: never clobber a real (non-symlink) dir we don't own ──────────
_link() {
  local target="$1" link="$2"
  if [ -L "$link" ] || [ ! -e "$link" ]; then
    ln -snf "$target" "$link"
    return 0
  fi
  echo "  skip (exists, not a symlink): $link" >&2
  return 1
}

skill_link_name() {
  local dir="$1" name
  name="$(basename "$dir")"
  local fname
  fname=$(grep -m1 '^name:' "$dir/SKILL.md" 2>/dev/null | sed 's/^name:[[:space:]]*//' | tr -d '[:space:]')
  [ -n "$fname" ] && name="$fname"
  printf '%s%s' "$PREFIX" "$name"
}

# ── wire a records notebook to this harness install ───────────────────────────
# Symlinks tools/ + .githooks/ (gitignored) so the skills' relative `tools/…`
# calls and the INDEX/figure pre-commit hook work from the notebook's cwd.
# ハーネスが「所有」するものを記録層へ配る。symlink で配れるものは symlink にする
# — cp で配ると更新が二度と届かない(既存ノートを更新する経路が無くなる)。
sync_owned() {
  local NB="$1"
  _link "$SRC/tools" "$NB/tools" || true
  _link "$SRC/.githooks" "$NB/.githooks" || true
  # 実験テンプレは「仕組み」なのでハーネスが持つ。/exp-new は symlink 越しに cp -R する。
  if [ -d "$NB/experiments" ] || mkdir -p "$NB/experiments" 2>/dev/null; then
    if [ -d "$NB/experiments/_template" ] && [ ! -L "$NB/experiments/_template" ]; then
      echo "  note: experiments/_template は実体コピーです。ハーネス更新が届かないので"
      echo "        退避して symlink に張り替えます → experiments/_template.local-backup"
      rm -rf "$NB/experiments/_template.local-backup"
      mv "$NB/experiments/_template" "$NB/experiments/_template.local-backup"
    fi
    _link "$SRC/experiments/_template" "$NB/experiments/_template" || true
  fi
  git -C "$NB" config core.hooksPath .githooks 2>/dev/null || true
  sync_gitignore_block "$NB"
  sync_gitattributes_block "$NB"
}

# マーカ間を本文で置換する(無ければ末尾に追記)。
# 本文は **ファイル経由**で awk に渡す — BSD awk(macOS) は -v に改行を含む値を
# 受け取れず「newline in string」で失敗する。GNU awk では通るため、Linux でだけ
# 動いて macOS で黙って更新されない、という形で長く潜んでいた。
_sync_marked_block() {   # $1=対象ファイル, $2=本文(複数行)
  local f="$1" body="$2" tmp
  local START="# >>> ikmstack managed (do not edit inside) >>>"
  local END="# <<< ikmstack managed <<<"
  touch "$f"
  tmp="$(mktemp)"; printf '%s\n' "$body" > "$tmp"
  if grep -qF "$START" "$f" 2>/dev/null; then
    awk -v s="$START" -v e="$END" -v bf="$tmp" '
      $0==s { print; while ((getline line < bf) > 0) print line; close(bf); skip=1; next }
      $0==e { skip=0; print; next }
      !skip { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  else
    { printf '\n%s\n' "$START"; cat "$tmp"; printf '%s\n' "$END"; } >> "$f"
  fi
  rm -f "$tmp"
}

# .gitignore の「ハーネス管理ブロック」をマーカ間で置換する(二重帳簿と同じ型)。
# ノート固有の行はマーカの外に書けば保持される。
sync_gitignore_block() {
  local NB="$1"
  _sync_marked_block "$NB/.gitignore" "$(cat <<'BLOCK'
/tools
/.githooks
/experiments/_template
experiments/INDEX.html
experiments/**/_generated/*.readview.html
experiments/**/verification/*.ipynb
experiments/**/verification/*.html
BLOCK
)"
  echo "  .gitignore: ハーネス管理ブロックを更新"
}

# .gitattributes の「ハーネス管理ブロック」。生成物をマージさせないための宣言。
# INDEX.md は experiments/*/REPORT.md から決定論で作られる生成物なので、行を
# 突き合わせても正しくならない。union で衝突を起こさず素通しし、post-merge が
# 作り直す(= 生成物はマージせず再生成する)。
sync_gitattributes_block() {
  local NB="$1"
  _sync_marked_block "$NB/.gitattributes" "$(cat <<'BLOCK'
experiments/INDEX.md merge=union
BLOCK
)"
  echo "  .gitattributes: ハーネス管理ブロックを更新(生成物はマージせず再生成)"
}

# ── git の同期状態(多台運用の可視化)────────────────────────────────
# fetch はしない(遅い・ネットワークが要る)。--status は「前回 fetch 時点」の
# 差分と、ネットワーク不要な未コミット数を出す。fetch するのは --sync だけ。
git_state() {   # $1 = dir, $2 = "fresh" なら fetch 済みなので注記を付けない
  # autopush の有無もここで出す。呼び出し側で個別に足すと、片方だけ付け忘れる
  # (実際 --status のハーネス行に付け忘れていた)。
  local d="$1" fresh="${2:-}" up ahead behind dirty out ap
  git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || { printf 'git 管理外'; return; }
  dirty=$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  up=$(git -C "$d" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  if [ -n "$up" ]; then
    local counts
    counts=$(git -C "$d" rev-list --left-right --count "@{u}...HEAD" 2>/dev/null || echo "0 0")
    behind=$(printf '%s' "$counts" | awk '{print $1}')
    ahead=$(printf '%s' "$counts" | awk '{print $2}')
    out="未push ${ahead:-0} / 未pull ${behind:-0}"
    if [ "$fresh" != "fresh" ] && { [ "${behind:-0}" != "0" ] || [ "${ahead:-0}" != "0" ]; }; then
      out="$out (前回fetch時点)"
    fi
  else
    out="upstream 未設定"
  fi
  [ "${dirty:-0}" != "0" ] && out="$out / 未コミット $dirty"
  ap=$(git -C "$d" config --bool ikmstack.autopush 2>/dev/null || echo false)
  [ "$ap" = "true" ] && out="$out / autopush ON"
  printf '%s' "$out"
}

# 1 repo を fetch して ff-only で pull する。汚れていれば触らない(記録優先)。
sync_repo() {   # $1 = ラベル, $2 = dir
  local label="$1" d="$2" dirty
  if ! git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
    echo "  - $label: git 管理外 — スキップ"; return
  fi
  dirty=$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if [ "${dirty:-0}" != "0" ]; then
    echo "  ⚠ $label: 未コミットが $dirty 件あるため pull しません(先にコミットしてください)"
    return
  fi
  if ! git -C "$d" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    echo "  - $label: upstream 未設定 — スキップ"; return
  fi
  git -C "$d" fetch --quiet 2>/dev/null || { echo "  ⚠ $label: fetch 失敗(ネットワーク?)"; return; }
  if git -C "$d" pull --ff-only --quiet 2>/dev/null; then
    echo "  ✓ $label: $(git_state "$d" fresh)"
  else
    echo "  ⚠ $label: ff-only で pull できません(分岐しています)。"
    echo "      → cd $d && git status で確認し、手で解決してください"
  fi
}

wire_notebook() {
  local NB="$1"
  sync_owned "$NB"
  # register this notebook so sidecar routing (tools/sidecar.py) can find it
  # from any product repo. `notebooks` = all wired (wire order, deduped);
  # `notebook` = the default = last wired (where sidecar records land).
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$NB" > "$STATE_DIR/notebook"
  touch "$STATE_DIR/notebooks"
  grep -qxF "$NB" "$STATE_DIR/notebooks" 2>/dev/null || printf '%s\n' "$NB" >> "$STATE_DIR/notebooks"
  echo "  wired: tools/ → $SRC/tools, .githooks/ → $SRC/.githooks (gitignored, hooksPath set)"
  echo "  registered notebook → $STATE_DIR/notebooks (default → $STATE_DIR/notebook)"
}

# ── scaffold a NEW records notebook from scratch ──────────────────────────────
init_notebook() {
  local NB_ARG="$1"
  local NB NAME TPL="$SRC/notebook-template"
  NB="$NB_ARG"
  case "$NB" in /*) : ;; *) NB="$PWD/$NB" ;; esac   # absolutize
  NAME="$(basename "$NB")"
  if [ -e "$NB" ] && [ -n "$(ls -A "$NB" 2>/dev/null)" ]; then
    echo "refusing: $NB already exists and is not empty" >&2; exit 1
  fi
  [ -d "$TPL" ] || { echo "missing notebook-template in $SRC" >&2; exit 1; }

  mkdir -p "$NB/experiments" "$NB/logs/$(date +%Y)" "$NB/tips" "$NB/decisions"
  # 実験テンプレは wire_notebook が symlink で張る(ハーネス更新が届くようにする)。
  # INDEX は記録なのでコピー（以後ノートが育てる）。
  cp "$SRC/experiments/INDEX.md" "$NB/experiments/INDEX.md"
  : > "$NB/logs/$(date +%Y)/.gitkeep"; : > "$NB/tips/.gitkeep"; : > "$NB/decisions/.gitkeep"

  # notebook docs (substitute {{NOTEBOOK}} → dir basename)
  for f in README.md AGENTS.md CLAUDE.md; do
    sed "s/{{NOTEBOOK}}/$NAME/g" "$TPL/$f" > "$NB/$f"
  done
  sed "s/{{NOTEBOOK}}/$NAME/g" "$TPL/gitignore" > "$NB/.gitignore"
  sed "s/{{NOTEBOOK}}/$NAME/g" "$TPL/lab-config.json.template" > "$NB/.lab-config.json.template"
  cp "$NB/.lab-config.json.template" "$NB/.lab-config.json"

  git -C "$NB" init -q -b main
  wire_notebook "$NB"

  echo "notebook scaffolded: $NB"
  echo ""
  echo "Next:"
  echo "  1. cd $NB && git add -A && git commit -m 'init: $NAME (records layer)'"
  echo "  2. gh repo create <owner>/$NAME --private --source=. --remote=origin --push"
  echo "  3. start working: /exp-new (experiment) or /lab-log (daily log)"
}

case "$MODE" in
  install)
    mkdir -p "$SKILLS_DST" "$AGENTS_DST" "$STATE_DIR"
    linked=()
    for d in "$SRC"/.claude/skills/*/; do
      [ -f "$d/SKILL.md" ] || continue
      name="$(skill_link_name "$d")"
      if _link "$d" "$SKILLS_DST/$name"; then linked+=("$name"); fi
    done
    for a in "$SRC"/.claude/agents/*.md; do
      [ -f "$a" ] || continue
      _link "$a" "$AGENTS_DST/$(basename "$a")" || true
    done
    printf '%s\n' "$SRC" > "$STATE_DIR/install-path"
    # ハーネス自身にもコミット関門を張る。ここを忘れると policy gate / harness map /
    # notebook map が「① で編集したときだけ」走らない = 一番効かせたい場所で無効になる。
    git -C "$SRC" config core.hooksPath .githooks 2>/dev/null || true
    echo "ikmstack installed."
    echo "  skills → $SKILLS_DST : ${linked[*]}"
    echo "  agents → $AGENTS_DST : $(ls "$SRC"/.claude/agents 2>/dev/null | tr '\n' ' ')"
    echo "  install path recorded → $STATE_DIR/install-path"
    echo "  commit gates          → core.hooksPath=.githooks (this repo)"
    echo ""
    echo "Next: wire a records notebook with  ./setup --notebook <path-to-ikmnote>"
    ;;

  sync-notebook)
    # ハーネスが所有するものだけを更新する。登録(既定ノート)は変更しない。
    [ -n "$NOTEBOOK" ] || { echo "usage: ./setup --sync-notebook <dir>" >&2; exit 1; }
    NB="$(cd "$NOTEBOOK" && pwd -P)" || { echo "notebook dir not found: $NOTEBOOK" >&2; exit 1; }
    echo "syncing harness-owned files in: $NB"
    sync_owned "$NB"
    # 散文（AGENTS/CLAUDE/README）は自動マージできないので差分を報告するに留める
    echo ""
    echo "  ノート固有の散文はハーネスが上書きしません。テンプレとの差分:"
    NAME="$(basename "$NB")"
    for f in AGENTS.md CLAUDE.md README.md; do
      [ -f "$NB/$f" ] && [ -f "$SRC/notebook-template/$f" ] || continue
      n=$(diff <(sed "s/$NAME/{{NOTEBOOK}}/g" "$NB/$f") "$SRC/notebook-template/$f" 2>/dev/null | grep -c '^[<>]')
      if [ "${n:-0}" -gt 0 ]; then
        echo "    ⚠ $f: 差分 $n 行 — 必要なら手で追随（diff で確認）"
      else
        echo "    ✓ $f"
      fi
    done
    echo ""
    echo "  完了。記録には一切触れていません。"
    ;;

  notebook)
    [ -n "$NOTEBOOK" ] || { echo "usage: ./setup --notebook <dir>" >&2; exit 1; }
    NB="$(cd "$NOTEBOOK" && pwd -P)" || { echo "notebook dir not found: $NOTEBOOK" >&2; exit 1; }
    echo "wiring notebook: $NB"
    wire_notebook "$NB"
    ;;

  init-notebook)
    [ -n "$NOTEBOOK" ] || { echo "usage: ./setup --init-notebook <dir>" >&2; exit 1; }
    init_notebook "$NOTEBOOK"
    ;;

  forget-notebook)
    # 登録の解除だけ。notebook の中身（記録）には一切触らない
    [ -n "$NOTEBOOK" ] || { echo "usage: ./setup --forget-notebook <dir>" >&2; exit 1; }
    NB="$(cd "$NOTEBOOK" 2>/dev/null && pwd -P)" || NB="$NOTEBOOK"
    if [ -f "$STATE_DIR/notebooks" ]; then
      grep -vxF "$NB" "$STATE_DIR/notebooks" > "$STATE_DIR/notebooks.tmp" 2>/dev/null || true
      mv "$STATE_DIR/notebooks.tmp" "$STATE_DIR/notebooks"
    fi
    if [ "$(cat "$STATE_DIR/notebook" 2>/dev/null)" = "$NB" ]; then
      # 既定が消えたら残りの最後（＝直近に wire したもの）を既定に繰り上げる
      tail -n 1 "$STATE_DIR/notebooks" 2>/dev/null > "$STATE_DIR/notebook" || : > "$STATE_DIR/notebook"
    fi
    echo "forgot notebook: ${NB}（登録の解除のみ。記録そのものは削除していない）"
    echo "  default → $(cat "$STATE_DIR/notebook" 2>/dev/null || echo '(なし)')"
    ;;

  status)
    echo "ikmstack status"
    echo "  harness (this repo) : $SRC"
    miss=0; ok=0
    # install-path
    ip=$(cat "$STATE_DIR/install-path" 2>/dev/null || echo "")
    if [ -z "$ip" ]; then
      echo "  install-path        : (未記録) — 未 install"; miss=$((miss+1))
    elif [ "$ip" = "$SRC" ]; then
      echo "  install-path        : $ip ✓"
    else
      echo "  install-path        : $ip ⚠ この repo と不一致（別の場所を install 済み）"
    fi
    echo "  git (harness)       : $(git_state "$SRC")"
    # ハーネス自身のコミット関門(ここが未設定だと policy/map/nbmap が一度も走らない)
    hp=$(git -C "$SRC" config --get core.hooksPath 2>/dev/null || echo "")
    if [ "$hp" = ".githooks" ]; then
      echo "  commit gates        : core.hooksPath=.githooks ✓"
    else
      echo "  commit gates        : ✗ 未設定 — ハーネス側の関門が走りません（./setup で修復）"
      miss=$((miss+1))
    fi
    # skills
    echo "  skills (~/.claude/skills):"
    for d in "$SRC"/.claude/skills/*/; do
      [ -f "$d/SKILL.md" ] || continue
      name="$(skill_link_name "$d")"; link="$SKILLS_DST/$name"; want="${d%/}"
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        echo "    ✗ $name (切れリンク)"; miss=$((miss+1))
      elif [ -L "$link" ]; then
        tgt="$(readlink "$link")"; tgt="${tgt%/}"
        if [ "$tgt" = "$want" ]; then echo "    ✓ $name"; ok=$((ok+1))
        else echo "    ⚠ $name (別を指す: $tgt)"; miss=$((miss+1)); fi
      elif [ -e "$link" ]; then
        echo "    ⚠ $name (symlink でない実体)"; miss=$((miss+1))
      else
        echo "    ✗ $name (未配置)"; miss=$((miss+1))
      fi
    done
    # agents
    echo "  agents (~/.claude/agents):"
    for a in "$SRC"/.claude/agents/*.md; do
      [ -f "$a" ] || continue
      link="$AGENTS_DST/$(basename "$a")"
      if [ -L "$link" ] && [ "$(readlink "$link")" = "$a" ]; then
        echo "    ✓ $(basename "$a")"
      else
        echo "    ✗ $(basename "$a")"; miss=$((miss+1))
      fi
    done
    # external tools（ハーネスが symlink できない前提 = OS 側の依存）
    # なぜ見るか: エージェントに道具を持たせることと、その道具が動くことは別。
    # 実例(E007): dr-verifier に Read を足しても poppler が無く、PDF 検証は
    # "pdftoppm is not installed" で落ちた。install 健全性の表に出ていなかったので
    # 誰も気づけなかった。欠けても install 自体は成立するので miss には数えず、
    # 「その機能が使えない」ことだけを名指しする。
    echo "  external tools（欠けるとその機能だけが落ちる）:"
    ext_missing=0
    check_ext() {  # $1=コマンド $2=これが無いと落ちる機能 $3=入れ方
      if command -v "$1" >/dev/null 2>&1; then
        echo "    ✓ $1 — $2"
      else
        echo "    ✗ $1 (未導入) — $2 が使えません → $3"
        ext_missing=$((ext_missing+1))
      fi
    }
    check_ext pdftoppm "dr-verifier の PDF 検証（Read のページ指定）" "brew install poppler"
    check_ext soffice  "exp-deck のスライド可視検証（pptx→画像）" "brew install --cask libreoffice"

    # notebooks（複数対応。* が既定 = sidecar 記録の集約先）
    nb=$(cat "$STATE_DIR/notebook" 2>/dev/null || echo "")
    all=$(cat "$STATE_DIR/notebooks" 2>/dev/null || echo "")
    [ -n "$nb" ] && all=$(printf '%s\n%s\n' "$all" "$nb" | grep -v '^$' | awk '!seen[$0]++')
    if [ -z "$all" ]; then
      echo "  notebooks           : (未登録) — ./setup --notebook <dir> または --init-notebook <dir>"
    else
      echo "  notebooks (* = 既定 / sidecar 集約先):"
      while IFS= read -r n; do
        [ -n "$n" ] || continue
        mark=" "; [ "$n" = "$nb" ] && mark="*"
        if [ ! -d "$n" ]; then
          echo "   $mark $n ✗ 存在しない"; miss=$((miss+1))
        elif [ -L "$n/tools" ] && [ -L "$n/.githooks" ]; then
          echo "   $mark $n ✓ 配線済"
          echo "       git: $(git_state "$n")"
        else
          echo "   $mark $n ⚠ 未配線（./setup --notebook ${n}）"; miss=$((miss+1))
        fi
      done <<< "$all"
    fi
    # verdict
    echo ""
    if [ "$miss" -eq 0 ]; then
      echo "  verdict: ✅ インストール済み（skills $ok 個 OK）"
    elif [ -z "$ip" ]; then
      echo "  verdict: ❌ 未インストール → 実行:  ./setup"
    else
      echo "  verdict: ⚠ 一部欠落 $miss 件 → 再実行して修復:  ./setup"
    fi
    # external tools は install の成否と別軸なので、verdict とは別行で伝える。
    if [ "$ext_missing" -gt 0 ]; then
      echo "  note   : external tools が $ext_missing 件未導入（./setup では直りません。上の入れ方を参照）"
    fi
    ;;

  sync)
    echo "ikmstack sync — ハーネスと登録ノートを fetch + ff-only pull します"
    echo ""
    sync_repo "harness ($(basename "$SRC"))" "$SRC"
    nb=$(cat "$STATE_DIR/notebook" 2>/dev/null || echo "")
    all=$(cat "$STATE_DIR/notebooks" 2>/dev/null || echo "")
    [ -n "$nb" ] && all=$(printf '%s\n%s\n' "$all" "$nb" | grep -v '^$' | awk '!seen[$0]++')
    if [ -z "$all" ]; then
      echo "  - notebooks: 未登録"
    else
      while IFS= read -r n; do
        [ -n "$n" ] || continue
        if [ ! -d "$n" ]; then
          echo "  ⚠ $(basename "$n"): 存在しません(./setup --forget-notebook $n)"
        else
          sync_repo "$(basename "$n")" "$n"
        fi
      done <<< "$all"
    fi
    echo ""
    echo "  未push が残っている repo は、その repo で git push してください。"
    echo "  記録層を自動 push したい場合: cd <ノート> && git config --bool ikmstack.autopush true"
    ;;

  uninstall)
    removed=0
    for d in "$SRC"/.claude/skills/*/; do
      [ -f "$d/SKILL.md" ] || continue
      link="$SKILLS_DST/$(skill_link_name "$d")"
      if [ -L "$link" ] && [ "$(readlink "$link")" = "${d%/}" ] || [ "$(readlink "$link")" = "$d" ]; then
        rm -f "$link"; removed=$((removed+1))
      fi
    done
    for a in "$SRC"/.claude/agents/*.md; do
      [ -f "$a" ] || continue
      link="$AGENTS_DST/$(basename "$a")"
      [ -L "$link" ] && [ "$(readlink "$link")" = "$a" ] && { rm -f "$link"; removed=$((removed+1)); }
    done
    echo "uninstalled $removed symlink(s)."
    ;;
esac
