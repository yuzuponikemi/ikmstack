{
  "_role": "① ハーネス repo 自身の設定の雛形。② 記録層の雛形は notebook-template/lab-config.json.template",
  "experiment_id_pattern": "^E\\d+_[a-z0-9-]+$",
  "experiment_id_prefix": "E",
  "jira_enabled": false,
  "jira_base_url": "https://your-company.atlassian.net/browse/",
  "jira_project_key": "PROJ",
  "_google_drive_root_note": "macOS の Drive for desktop のマウント先。個人アカウントは 'My Drive'(日本語環境でも英語名)。Workspace の共有ドライブなら 'Shared drives/<drive>'",
  "google_drive_root": "~/Library/CloudStorage/GoogleDrive-<account>/My Drive/<notebook>/experiments/",
  "allowed_figure_roots": [
    "_generated",
    "figures"
  ],
  "retraction_rule_epoch": "0000-00-00",
